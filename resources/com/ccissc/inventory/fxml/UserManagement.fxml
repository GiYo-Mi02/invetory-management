<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ccissc.inventory.controller.UserManagementController">
    <top>
        <fx:include source="components/Navbar.fxml" />
    </top>
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="User Management" styleClass="page-title" />
            <HBox spacing="10">
                <Button text="Add User" onAction="#onAddUser" styleClass="primary-button" />
                <Button text="Change Role" onAction="#onChangeRole" styleClass="ghost-button" />
                <Button text="Toggle Active" onAction="#onToggleActive" styleClass="ghost-button" />
                <Button text="Delete" onAction="#onDeleteUser" styleClass="danger-button" />
            </HBox>
            <TableView fx:id="userTable" prefHeight="420">
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="200" />
                    <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="260" />
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="140" />
                    <TableColumn fx:id="activeColumn" text="Active" prefWidth="120" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>