<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ccissc.inventory.controller.UserManagementController">
    <top>
        <fx:include source="components/Navbar.fxml" />
    </top>
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <VBox spacing="6">
                <Label text="User Management" styleClass="page-title" />
                <Label fx:id="userCountLabel" text="0 users" styleClass="muted-text" />
            </VBox>
            <HBox spacing="10">
                <Button text="Add User" onAction="#onAddUser" styleClass="primary-button">
                    <graphic><FontIcon iconLiteral="fas-user-plus" iconSize="14" /></graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="resetPasswordButton" text="Reset Password" onAction="#onResetPassword" styleClass="ghost-button">
                    <graphic><FontIcon iconLiteral="fas-key" iconSize="14" /></graphic>
                </Button>
                <Button fx:id="changeRoleButton" text="Change Role" onAction="#onChangeRole" styleClass="ghost-button">
                    <graphic><FontIcon iconLiteral="fas-user-pen" iconSize="14" /></graphic>
                </Button>
                <Button fx:id="toggleActiveButton" text="Toggle Active" onAction="#onToggleActive" styleClass="ghost-button">
                    <graphic><FontIcon iconLiteral="fas-toggle-on" iconSize="14" /></graphic>
                </Button>
                <Button fx:id="deleteUserButton" text="Delete" onAction="#onDeleteUser" styleClass="danger-button">
                    <graphic><FontIcon iconLiteral="fas-user-minus" iconSize="14" /></graphic>
                </Button>
            </HBox>
            <TableView fx:id="userTable" prefHeight="420" VBox.vgrow="ALWAYS">
                <placeholder>
                    <VBox spacing="8" alignment="CENTER">
                        <FontIcon iconLiteral="fas-users" iconSize="48" styleClass="icon-muted" />
                        <Label text="No users available." styleClass="muted-text" />
                    </VBox>
                </placeholder>
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="160" sortable="true" />
                    <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="200" sortable="true" />
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="120" sortable="true" />
                    <TableColumn fx:id="activeColumn" text="Active" prefWidth="80" sortable="true" />
                    <TableColumn fx:id="lastLoginColumn" text="Last Login" prefWidth="160" sortable="true" />
                    <TableColumn fx:id="actionCountColumn" text="Actions" prefWidth="80" sortable="true" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>