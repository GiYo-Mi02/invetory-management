<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ccissc.inventory.controller.DashboardController">
    <top>
        <fx:include source="components/Navbar.fxml" />
    </top>
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Dashboard" styleClass="page-title" />
            <HBox spacing="12">
                <VBox styleClass="stat-card" spacing="6">
                    <Region styleClass="stat-accent green" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-tag" iconSize="18" styleClass="icon-success" />
                        <Label text="Total Items" styleClass="stat-title" />
                    </HBox>
                    <Label fx:id="totalItemsLabel" text="0" styleClass="stat-value" />
                </VBox>
                <VBox styleClass="stat-card" spacing="6">
                    <Region styleClass="stat-accent blue" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-cubes" iconSize="18" styleClass="icon-info" />
                        <Label text="Total Stock" styleClass="stat-title" />
                    </HBox>
                    <Label fx:id="totalStockLabel" text="0" styleClass="stat-value" />
                </VBox>
                <VBox styleClass="stat-card" spacing="6">
                    <Region styleClass="stat-accent amber" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-triangle-exclamation" iconSize="18" styleClass="icon-warning" />
                        <Label text="Low Stock" styleClass="stat-title" />
                    </HBox>
                    <Label fx:id="lowStockLabel" text="0" styleClass="stat-value" />
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="quick-actions">
                <Label text="Quick Actions" styleClass="section-title" />
                <Button fx:id="manageUsersButton" text="Manage Users" onAction="#onManageUsers"
                        styleClass="primary-button">
                    <graphic><FontIcon iconLiteral="fas-user-gear" iconSize="14" /></graphic>
                </Button>
                <Separator styleClass="section-divider" />
            </VBox>

            <HBox spacing="16">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Top Items" styleClass="section-title" />
                    <BarChart fx:id="topItemsChart" prefHeight="240">
                        <xAxis>
                            <CategoryAxis />
                        </xAxis>
                        <yAxis>
                            <NumberAxis />
                        </yAxis>
                    </BarChart>
                </VBox>
                <VBox spacing="10" prefWidth="320">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-triangle-exclamation" iconSize="16" styleClass="icon-warning" />
                        <Label text="Low Stock Alerts" styleClass="section-title" />
                    </HBox>
                    <TableView fx:id="lowStockTable" prefHeight="240">
                        <placeholder>
                            <Label text="No low stock items." styleClass="muted-text" />
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="lowStockNameColumn" text="Item" prefWidth="200" />
                            <TableColumn fx:id="lowStockQtyColumn" text="Qty" prefWidth="80" />
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-clock-rotate-left" iconSize="16" styleClass="icon-muted" />
                <Label text="Recent Items" styleClass="section-title" />
            </HBox>
            <TableView fx:id="recentItemsTable" prefHeight="260" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No recent items yet." styleClass="muted-text" />
                </placeholder>
                <columns>
                    <TableColumn fx:id="itemNameColumn" text="Item" prefWidth="320" />
                    <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="120" />
                </columns>
            </TableView>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-clock-rotate-left" iconSize="16" styleClass="icon-muted" />
                <Label text="Recent Activity" styleClass="section-title" />
            </HBox>
            <TableView fx:id="activityTable" prefHeight="200">
                <placeholder>
                    <Label text="No recent activity." styleClass="muted-text" />
                </placeholder>
                <columns>
                    <TableColumn fx:id="activityActionColumn" text="Activity" prefWidth="360" />
                    <TableColumn fx:id="activityTimeColumn" text="Time" prefWidth="140" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>