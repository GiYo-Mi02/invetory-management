<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ccissc.inventory.controller.DashboardController">
    <top>
        <fx:include source="components/Navbar.fxml" />
    </top>
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Dashboard" styleClass="page-title" />
            <HBox spacing="12">
                <VBox styleClass="stat-card" spacing="6">
                    <Region styleClass="stat-accent green" />
                    <Label text="Total Items" styleClass="stat-title" />
                    <Label fx:id="totalItemsLabel" text="0" styleClass="stat-value" />
                </VBox>
                <VBox styleClass="stat-card" spacing="6">
                    <Region styleClass="stat-accent blue" />
                    <Label text="Total Stock" styleClass="stat-title" />
                    <Label fx:id="totalStockLabel" text="0" styleClass="stat-value" />
                </VBox>
                <VBox styleClass="stat-card" spacing="6">
                    <Region styleClass="stat-accent amber" />
                    <Label text="Low Stock" styleClass="stat-title" />
                    <Label fx:id="lowStockLabel" text="0" styleClass="stat-value" />
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="quick-actions">
                <Label text="Quick Actions" styleClass="section-title" />
                <Button fx:id="manageUsersButton" text="Manage Users" onAction="#onManageUsers"
                        styleClass="primary-button" />
                <Separator styleClass="section-divider" />
            </VBox>

            <Label text="Recent Items" styleClass="section-title" />
            <TableView fx:id="recentItemsTable" prefHeight="260" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No recent items yet." styleClass="muted-text" />
                </placeholder>
                <columns>
                    <TableColumn fx:id="itemNameColumn" text="Item" prefWidth="320" />
                    <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="120" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>