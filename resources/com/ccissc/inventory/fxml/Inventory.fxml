<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ccissc.inventory.controller.InventoryController">
    <top>
        <fx:include source="components/Navbar.fxml" />
    </top>
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Inventory" styleClass="page-title" />
            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="search-bar">
                    <TextField fx:id="searchField" promptText="Search items" onKeyReleased="#onSearch" />
                    <ComboBox fx:id="filterCombo" onAction="#onSearch" />
                    <Button text="Search" onAction="#onSearch" styleClass="ghost-button">
                        <graphic><FontIcon iconLiteral="fas-magnifying-glass" iconSize="14" /></graphic>
                    </Button>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="exportButton" text="Export CSV" onAction="#onExport" styleClass="ghost-button">
                    <graphic><FontIcon iconLiteral="fas-file-csv" iconSize="14" /></graphic>
                </Button>
                <Button fx:id="addButton" text="Add Item" onAction="#onAdd" styleClass="primary-button">
                    <graphic><FontIcon iconLiteral="fas-plus" iconSize="14" /></graphic>
                </Button>
            </HBox>
            <HBox spacing="16">
                <TableView fx:id="inventoryTable" prefHeight="420" prefWidth="700" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                    <placeholder>
                        <VBox spacing="8" alignment="CENTER">
                            <FontIcon iconLiteral="fas-boxes-stacked" iconSize="48" styleClass="icon-muted" />
                            <Label text="No items found." styleClass="muted-text" />
                        </VBox>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Item" prefWidth="420" sortable="true" />
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="140" sortable="true" />
                        <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="140" sortable="true" />
                        <TableColumn fx:id="adjustColumn" text="Adjust" prefWidth="120" sortable="false" />
                    </columns>
                </TableView>
                <VBox spacing="12" alignment="TOP_CENTER" styleClass="preview-card">
                    <Label text="Preview" styleClass="section-title" />
                    <ImageView fx:id="previewImageView" fitWidth="240" fitHeight="240" preserveRatio="true" />
                    <Label fx:id="previewPlaceholder" text="No item selected" styleClass="preview-placeholder" />
                    <TextArea fx:id="previewDescription" editable="false" wrapText="true" prefRowCount="4" />
                    <VBox spacing="8" alignment="CENTER" maxWidth="Infinity">
                        <Button fx:id="editButton" text="Edit" onAction="#onEdit" styleClass="ghost-button" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fas-pen-to-square" iconSize="14" /></graphic>
                        </Button>
                        <Button fx:id="deleteButton" text="Archive" onAction="#onDelete" styleClass="danger-button" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fas-trash" iconSize="14" /></graphic>
                        </Button>
                        <Button fx:id="restoreButton" text="Restore" onAction="#onRestore" styleClass="ghost-button" maxWidth="Infinity">
                            <graphic><FontIcon iconLiteral="fas-rotate-left" iconSize="14" /></graphic>
                        </Button>
                    </VBox>
                    <Label text="History" styleClass="section-title" />
                    <TableView fx:id="historyTable" prefHeight="220" maxWidth="Infinity">
                        <placeholder>
                            <Label text="Select an item to view history." styleClass="muted-text" />
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="historyActionColumn" text="Action" prefWidth="90" />
                            <TableColumn fx:id="historyNoteColumn" text="Note" prefWidth="140" />
                            <TableColumn fx:id="historyTimeColumn" text="Time" prefWidth="110" />
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>