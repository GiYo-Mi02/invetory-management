<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ccissc.inventory.controller.InventoryController">
    <top>
        <fx:include source="components/Navbar.fxml" />
    </top>
    <left>
        <fx:include source="components/Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="16" padding="20">
            <Label text="Inventory" styleClass="page-title" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search items" onKeyReleased="#onSearch" />
                <ComboBox fx:id="filterCombo" onAction="#onSearch" />
                <Button text="Search" onAction="#onSearch" styleClass="ghost-button" />
                <Button fx:id="addButton" text="Add Item" onAction="#onAdd" styleClass="primary-button" />
            </HBox>
            <HBox spacing="16">
                <TableView fx:id="inventoryTable" prefHeight="420" prefWidth="700">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Item" prefWidth="420" />
                        <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="140" />
                    </columns>
                </TableView>
                <VBox spacing="12" alignment="TOP_CENTER">
                    <Label text="Preview" styleClass="section-title" />
                    <ImageView fx:id="previewImageView" fitWidth="240" fitHeight="240" preserveRatio="true" />
                    <Button fx:id="editButton" text="Edit" onAction="#onEdit" styleClass="ghost-button" />
                    <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger-button" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
